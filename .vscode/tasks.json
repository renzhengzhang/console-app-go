{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "go: run",
            "type": "process",
            "command": "go",
            "args": [
                "run",
                "./cmd/console-app"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": "$go"
        },
        {
            "label": "go: build",
            "type": "process",
            "command": "go",
            "args": [
                "build",
                "-o",
                "${workspaceFolder}/bin/console-app",
                "./cmd/console-app"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$go"
        },
        {
            "label": "go: test",
            "type": "process",
            "command": "go",
            "args": [
                "test",
                "./..."
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$go"
        }
    ]
}